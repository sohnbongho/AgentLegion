<div class="top-row navbar">
    <a class="brand" href="" title="AgentLegion">
        <span class="brand-mark" aria-hidden="true">AL</span>
        <span class="brand-name">AgentLegion</span>
    </a>
    <button title="Navigation menu" class="navbar-toggler" aria-expanded="@(!collapseNavMenu)" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="CloseNavMenu">
    <nav class="flex-column" aria-label="Main">
        @foreach (var group in groups)
        {
            <div class="nav-section">@group.Title</div>
            @foreach (var item in group.Items)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="@item.Href" Match="@item.Match">
                        <span class="oi @item.Icon" aria-hidden="true"></span>
                        <span class="nav-label">@item.Label</span>
                    </NavLink>
                </div>
            }
        }

        @if (Store.IsConfigured && Store.Jobs.Count > 0)
        {
            <div class="nav-section">Agents</div>
            @foreach (var job in Store.Jobs)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="@($"jobs/{job.Job}")" title="@job.Branch">
                        <span class="job-dot @(Sessions.IsRunning(job.Job) ? "running" : "idle")" aria-hidden="true"></span>
                        <span class="nav-label">@job.Job</span>
                        @if (job.Changes > 0)
                        {
                            <span class="job-changes" title="@job.Changes uncommitted changes">@job.Changes</span>
                        }
                    </NavLink>
                </div>
            }
        }
    </nav>

    <div class="nav-footer">
        <span class="status-dot" aria-hidden="true"></span>
        WSL workspace
    </div>
</div>

@implements IDisposable
@using AgentLegion.Services
@inject JobStore Store
@inject SessionManager Sessions

@code {
    private record NavItem(string Label, string Href, string Icon, NavLinkMatch Match = NavLinkMatch.Prefix);
    private record NavSection(string Title, NavItem[] Items);

    private static readonly NavSection[] groups =
    {
        new("Workspace", new[]
        {
            new NavItem("Dashboard", "", "oi-dashboard", NavLinkMatch.All),
            new NavItem("Jobs", "jobs", "oi-layers", NavLinkMatch.All),
        }),
        new("System", new[]
        {
            new NavItem("Settings", "settings", "oi-cog"),
        }),
    };

    private bool collapseNavMenu = true;
    private bool disposed;

    protected override void OnInitialized()
    {
        Store.Changed += OnJobsChanged;
        Sessions.Changed += OnJobsChanged;
        // Listing shells out to WSL; don't hold up the first paint for it.
        if (!Store.Loaded) _ = Store.EnsureLoadedAsync();
    }

    private void OnJobsChanged()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (!disposed) StateHasChanged();
        });
    }

    public void Dispose()
    {
        disposed = true;
        Store.Changed -= OnJobsChanged;
        Sessions.Changed -= OnJobsChanged;
    }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void CloseNavMenu() => collapseNavMenu = true;
}
