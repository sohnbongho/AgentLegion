<div class="top-row navbar">
    <a class="brand" href="" title="AgentLegion">
        <span class="brand-mark" aria-hidden="true">AL</span>
        <span class="brand-name">AgentLegion</span>
    </a>
    <button title="Navigation menu" class="navbar-toggler" aria-expanded="@(!collapseNavMenu)" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="CloseNavMenu">
    <nav class="flex-column" aria-label="Main">
        @foreach (var group in groups)
        {
            <div class="nav-section">@group.Title</div>
            @foreach (var item in group.Items)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="@item.Href" Match="@item.Match">
                        <span class="oi @item.Icon" aria-hidden="true"></span>
                        <span class="nav-label">@item.Label</span>
                    </NavLink>
                </div>
            }
        }

        @if (Store.IsConfigured && Store.Jobs.Count > 0)
        {
            <div class="nav-section">Agents</div>
            @foreach (var job in Store.Jobs)
            {
                var state = Sessions.GetState(job.Job);
                <div class="nav-item">
                    <NavLink class="nav-link" href="@($"jobs/{job.Job}")" title="@($"{job.Branch} · {state.Label()}")">
                        <span class="job-dot @state.Css()" aria-hidden="true"></span>
                        <span class="nav-label">@job.Job</span>
                        @if (job.IsWindows)
                        {
                            <span class="job-env" title="Windows PowerShell job">PS</span>
                        }
                        <span class="job-state @state.Css()">@state.Label()</span>
                        @if (job.Changes > 0)
                        {
                            <span class="job-changes" title="@job.Changes uncommitted changes">@job.Changes</span>
                        }
                    </NavLink>
                </div>
            }
        }
    </nav>

    <div class="nav-footer" title="@WslTooltip">
        <span class="status-dot @(Wsl.Current is { Running: true } ? "on" : "off")" aria-hidden="true"></span>
        @if (Wsl.Current is { } w)
        {
            <span class="wsl-name">@w.Distro</span>
            <span class="wsl-meta">WSL@(w.Version) · @(w.Running ? "실행 중" : "중지됨")</span>
        }
        else
        {
            <span class="wsl-name">WSL</span>
            <span class="wsl-meta">@(Store.IsConfigured ? "확인 중…" : "설정 필요")</span>
        }
    </div>
</div>

@implements IDisposable
@using AgentLegion.Services
@inject JobStore Store
@inject SessionManager Sessions
@inject WslInfoService Wsl

@code {
    private record NavItem(string Label, string Href, string Icon, NavLinkMatch Match = NavLinkMatch.Prefix);
    private record NavSection(string Title, NavItem[] Items);

    private static readonly NavSection[] groups =
    {
        new("Workspace", new[]
        {
            new NavItem("Dashboard", "", "oi-dashboard", NavLinkMatch.All),
            new NavItem("Jobs", "jobs", "oi-layers", NavLinkMatch.All),
        }),
        new("System", new[]
        {
            new NavItem("Settings", "settings", "oi-cog"),
        }),
    };

    private bool collapseNavMenu = true;
    private bool disposed;

    protected override void OnInitialized()
    {
        Store.Changed += OnJobsChanged;
        Sessions.Changed += OnJobsChanged;
        // Listing shells out to WSL; don't hold up the first paint for it.
        if (!Store.Loaded) _ = Store.EnsureLoadedAsync();
        Wsl.Changed += OnJobsChanged;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Only the live circuit polls WSL (not the prerender pass).
        if (firstRender) _ = PollWslAsync();
    }

    private async Task PollWslAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            do { await Wsl.RefreshAsync(); }
            while (await timer.WaitForNextTickAsync(wslCts.Token));
        }
        catch (OperationCanceledException) { }
    }

    private readonly CancellationTokenSource wslCts = new();

    private string WslTooltip => Wsl.Current is not { } w
        ? "WSL 정보를 확인하는 중입니다"
        : string.Join("\n", new[]
        {
            $"Distribution: {w.Distro}{(w.IsDefault ? " (default)" : "")}",
            $"State: {(w.Running ? "Running" : "Stopped")} · WSL{w.Version}",
            w.WslVersion is null ? null : $"WSL version: {w.WslVersion}",
            w.Os is null ? null : $"OS: {w.Os}",
            w.Kernel is null ? null : $"Kernel: {w.Kernel}",
            w.User is null ? null : $"User: {w.User}@{w.Host}",
        }.Where(l => l is not null));

    private void OnJobsChanged()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (!disposed) StateHasChanged();
        });
    }

    public void Dispose()
    {
        disposed = true;
        Store.Changed -= OnJobsChanged;
        Sessions.Changed -= OnJobsChanged;
        Wsl.Changed -= OnJobsChanged;
        wslCts.Cancel();
        wslCts.Dispose();
    }

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void CloseNavMenu() => collapseNavMenu = true;
}
