@inject FileBrowserState State
@implements IDisposable

@if (State.SelectedPath is null)
{
    <div class="text-muted">좌측 트리에서 파일을 선택하세요. md, puml, html 파일은 미리 보기를 지원합니다.</div>
}
else if (State.PreviewLoading)
{
    <div class="text-muted">
        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
        파일을 불러오는 중...
    </div>
}
else if (State.PreviewError is not null)
{
    <div class="alert alert-danger" role="alert">
        <strong>파일 로딩 실패:</strong> @State.PreviewError
    </div>
}
else if (State.Preview is { } p)
{
    <div class="fp-header mb-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge bg-secondary text-uppercase">@KindLabel(p.Kind)</span>
            <code class="fp-path" title="@p.LinuxPath">@p.LinuxPath</code>
        </div>
        <div class="d-flex gap-3 mt-1 small text-muted align-items-center flex-wrap">
            <span><strong>크기:</strong> @FormatBytes(p.Size)</span>
            <span><strong>수정:</strong> @p.Modified.ToString("yyyy-MM-dd HH:mm:ss")</span>
            @if (HasRendered(p))
            {
                <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="보기 방식">
                    <button type="button" class="btn @(_showSource ? "btn-outline-primary" : "btn-primary")" @onclick="() => _showSource = false">미리 보기</button>
                    <button type="button" class="btn @(_showSource ? "btn-primary" : "btn-outline-primary")" @onclick="() => _showSource = true">소스</button>
                </div>
                @if (p.Kind == PreviewKind.Html && !_showSource)
                {
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" id="allowScripts" @bind="_allowScripts" />
                        <label class="form-check-label" for="allowScripts" title="샌드박스 안에서 실행되며 앱에는 접근할 수 없습니다">스크립트 허용</label>
                    </div>
                }
            }
        </div>
    </div>

    @if (p.Notice is not null)
    {
        <div class="alert alert-warning py-2 small mb-2" role="alert">@p.Notice</div>
    }

    @switch (p.Kind)
    {
        case PreviewKind.TooLarge:
            <div class="text-muted">파일이 너무 커서(@FormatBytes(WslFileService.MaxPreviewBytes) 초과) 미리 보기를 할 수 없습니다.</div>
            break;
        case PreviewKind.Binary:
            <div class="text-muted">바이너리 파일은 미리 보기를 지원하지 않습니다.</div>
            break;
        default:
            @if (!HasRendered(p) || _showSource)
            {
                <pre class="fp-source">@p.Source</pre>
            }
            else if (p.Kind == PreviewKind.PlantUml)
            {
                <div class="fp-diagram">
                    <img src="@SvgDataUri(p.Rendered!)" alt="@p.LinuxPath" />
                </div>
            }
            else if (p.Kind == PreviewKind.Markdown)
            {
                @* no scripts; links open in a new tab *@
                <iframe class="fp-frame" sandbox="allow-popups allow-popups-to-escape-sandbox" srcdoc="@p.Rendered" title="Markdown preview"></iframe>
            }
            else
            {
                @* without allow-same-origin the page gets an opaque origin and cannot touch the app *@
                <iframe @key="_allowScripts" class="fp-frame" sandbox="@(_allowScripts ? "allow-scripts allow-popups" : "allow-popups")" srcdoc="@p.Rendered" title="HTML preview"></iframe>
            }
            break;
    }
}

<style>
    .fp-path {
        font-size: 1rem;
        word-break: break-all;
    }
    .fp-source {
        flex: 1 1 auto;
        margin: 0;
        white-space: pre-wrap;
        word-break: break-word;
        background: #f8f9fa;
        padding: .75rem;
        border-radius: .375rem;
        overflow: auto;
        font-size: .85rem;
    }
    .fp-frame {
        flex: 1 1 auto;
        width: 100%;
        min-height: 20rem;
        border: 1px solid #dee2e6;
        border-radius: .375rem;
        background: #fff;
    }
    .fp-diagram {
        flex: 1 1 auto;
        overflow: auto;
    }
    .fp-diagram img {
        max-width: 100%;
    }
</style>

@code {
    private bool _showSource;
    private bool _allowScripts;
    private string? _lastPath;

    protected override void OnInitialized()
    {
        _lastPath = State.SelectedPath;
        State.Changed += OnStateChanged;
    }

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
    }

    private void OnStateChanged()
    {
        ResetOnNewFile();
        InvokeAsync(StateHasChanged);
    }

    // every file opens in preview mode with scripts off
    private void ResetOnNewFile()
    {
        if (State.SelectedPath == _lastPath) return;
        _lastPath = State.SelectedPath;
        _showSource = false;
        _allowScripts = false;
    }

    private static bool HasRendered(FilePreview p) =>
        p.Rendered is not null && p.Kind is PreviewKind.Markdown or PreviewKind.PlantUml or PreviewKind.Html;

    private static string SvgDataUri(string svg) =>
        "data:image/svg+xml;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg));

    private static string KindLabel(PreviewKind kind) => kind switch
    {
        PreviewKind.Markdown => "markdown",
        PreviewKind.PlantUml => "plantuml",
        PreviewKind.Html => "html",
        PreviewKind.Binary => "binary",
        _ => "text",
    };

    private static string FormatBytes(long bytes)
    {
        const long k = 1024;
        if (bytes < k) return $"{bytes} B";
        if (bytes < k * k) return $"{bytes / (double)k:N1} KiB";
        if (bytes < k * k * k) return $"{bytes / (double)(k * k):N1} MiB";
        return $"{bytes / (double)(k * k * k):N2} GiB";
    }
}
