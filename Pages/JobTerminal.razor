@page "/jobs/{Name}"
@using System.Threading.Channels
@using AgentLegion.Services
@implements IAsyncDisposable
@inject SessionManager Sessions
@inject JobStore Store
@inject NavigationManager Nav
@inject LegionService Legion
@inject IJSRuntime JS

<PageTitle>@Name - AgentLegion</PageTitle>

<div class="d-flex align-items-center mb-2 gap-2 flex-wrap">
    <h1 class="h3 mb-0 me-2">@Name</h1>
    <span class="badge @StateBadge(Sessions.GetState(Name))">@Sessions.GetState(Name).Label()</span>
    @if (Store.Jobs.FirstOrDefault(j => j.Job == Name) is { IsWindows: true })
    {
        <span class="badge bg-info text-dark" title="claude runs in Windows PowerShell">PowerShell</span>
    }
    @if (Sessions.ResumedId(Name) is { } rid)
    {
        <span class="badge bg-light text-dark border" title="@($"Resumed Claude session {rid}")">이어서 · @ShortId(rid)</span>
    }
    else if (connecting)
    {
        <span class="text-muted small">세션 확인 중…</span>
    }
    <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" disabled="@openingEditor" @onclick="OpenEditorAsync" title="이 job 폴더에서 code . 실행">VS Code</button>
        <button class="btn btn-sm btn-outline-secondary" disabled="@openingEditor" @onclick="OpenShellAsync" title="이 job 폴더에서 일반 터미널(셸) 열기 - claude 아님">Terminal</button>
        <button class="btn btn-sm @(showEditor ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => showEditor = !showEditor" title="이름, 브랜치, repo, 작업 경로 수정">Edit</button>
        <a class="btn btn-sm btn-outline-secondary" href="jobs">Jobs</a>
        @if (running)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="StopAsync">Stop</button>
        }
        else
        {
            <button class="btn btn-sm btn-primary" disabled="@connecting" @onclick="() => RestartAsync(false)" title="마지막 대화를 이어서 시작합니다 (claude --resume)">Start</button>
        }
        <button class="btn btn-sm @(confirmNew ? "btn-warning" : "btn-outline-primary")" disabled="@connecting" @onclick="NewSessionAsync"
                title="새 대화로 시작합니다. 실행 중이면 현재 세션을 종료하고 시작합니다.">New session</button>
    </div>
</div>

@if (confirmNew)
{
    <div class="alert alert-warning py-2 d-flex align-items-center gap-2" role="alert">
        <span class="me-auto">
            실행 중인 세션을 <strong>종료하고 새 대화로 시작</strong>합니다. 지금 대화는 Claude 기록에 남아 있어 나중에 직접 다시 열 수 있습니다.
        </span>
        <button class="btn btn-sm btn-warning" @onclick="NewSessionAsync">새 대화로 시작</button>
        <button class="btn btn-sm btn-link text-nowrap" @onclick="() => confirmNew = false">취소</button>
    </div>
}

@if (showEditor && Store.Jobs.FirstOrDefault(x => x.Job == Name) is { } editing)
{
    <JobEditor Job="editing" OnSaved="OnEdited" OnClose="CloseEditor" />
}

@if (editorResult is { Ok: false })
{
    <div class="alert alert-warning py-2 d-flex" role="alert">
        <span class="me-auto">열지 못했습니다: @editorResult.Output</span>
        <button class="btn btn-sm btn-link py-0 text-nowrap" @onclick="() => editorResult = null">닫기</button>
    </div>
}

@if (error is not null)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
else if (!running && started)
{
    <div class="alert alert-secondary py-2" role="status">세션이 종료되었습니다. Start로 다시 시작할 수 있습니다.</div>
}

<div @ref="termEl" class="terminal-host"></div>

@code {
    private record TermSize(int Cols, int Rows);

    [Parameter] public string Name { get; set; } = "";

    private ElementReference termEl;
    private DotNetObjectReference<JobTerminal>? self;
    private PtySession? session;
    private Action<byte[]>? listener;
    private Channel<byte[]>? pump;
    private readonly string termId = Guid.NewGuid().ToString("N");
    private static string StateBadge(SessionState s) => s switch
    {
        SessionState.Working => "bg-primary",
        SessionState.Waiting => "bg-warning text-dark",
        _ => "bg-secondary",
    };

    private bool initialized;          // xterm exists and the first job is connected
    private string? connectedName;      // the job the terminal is currently showing
    private int generation;             // bumped on every detach, see PumpAsync
    private bool running;
    private bool started;
    private bool connecting;
    private bool openingEditor;
    private bool showEditor;
    private bool confirmNew;           // "end the running session and start a new conversation?" is showing
    private CommandResult? editorResult;
    private bool disposed;
    private string? error;
    private TermSize size = new(120, 30);

    protected override void OnInitialized()
    {
        Sessions.Changed += OnSessionsChanged;
        Store.Changed += OnSessionsChanged;
        running = Sessions.IsRunning(Name);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        try
        {
            size = await JS.InvokeAsync<TermSize>("legionTerm.init", termId, termEl, self);
            initialized = true;
            connectedName = Name;
            await ConnectAsync();
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            error = ex.Message;
            StateHasChanged();
        }
    }

    // The router keeps this component instance when only {Name} changes (sidebar: job A -> job B), so
    // OnAfterRender(firstRender) never runs again. Without this, the page header says B while the terminal
    // stays attached to A - and keystrokes would go to A's session.
    protected override async Task OnParametersSetAsync()
    {
        if (!initialized || disposed || Name == connectedName) return;
        try { await SwitchJobAsync(); }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    // Leave the previous job's session running, detach from it, and show/start the new job's session.
    private async Task SwitchJobAsync()
    {
        Disconnect();
        connectedName = Name;
        confirmNew = false; // a pending "end this session?" belonged to the job we just left
        started = false;
        error = null;
        editorResult = null;
        running = Sessions.IsRunning(Name);
        await JS.InvokeVoidAsync("legionTerm.reset", termId);
        size = await JS.InvokeAsync<TermSize>("legionTerm.size", termId);
        await ConnectAsync();
        await JS.InvokeVoidAsync("legionTerm.focus", termId);
    }

    // Start the job's session (or re-attach to the running one) and stream its output into xterm.
    // A new session continues the job's last Claude conversation unless `fresh` is set.
    private async Task ConnectAsync(bool fresh = false)
    {
        error = null;
        var job = Name; // the user may navigate to another job while we await below
        try
        {
            string? resumeId = null;
            if (!fresh && !Sessions.IsRunning(job) && Legion.LoadConfig() is { ResumeLastSession: true })
            {
                connecting = true;
                await InvokeAsync(StateHasChanged);
                // the id of the newest conversation in this job's folder (a file name on disk, so it survives restarts)
                resumeId = (await Legion.GetLastSessionAsync(job))?.Id;
            }
            if (disposed || job != Name) return; // moved on: the switch to the new job connects it
            session = Sessions.GetOrStart(job, size.Cols, size.Rows, resumeId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            return;
        }
        finally
        {
            connecting = false;
        }

        started = true;
        running = session.IsRunning;
        pump = Channel.CreateUnbounded<byte[]>();
        _ = PumpAsync(pump.Reader, generation);

        var ch = pump.Writer;
        listener = chunk => ch.TryWrite(chunk);
        session.Attach(listener);
        session.Resize(size.Cols, size.Rows); // makes a full-screen app repaint for the new viewer
        session.Exited += OnSessionExited;
        StateHasChanged();
    }

    // Single consumer keeps chunks in order and merges bursts into fewer interop calls.
    // A pump belongs to one attachment (`gen`); once the terminal moved to another job it must write nothing more.
    private async Task PumpAsync(ChannelReader<byte[]> reader, int gen)
    {
        try
        {
            while (await reader.WaitToReadAsync())
            {
                using var ms = new MemoryStream();
                while (ms.Length < 65536 && reader.TryRead(out var chunk)) ms.Write(chunk);
                if (gen != generation) return;
                await JS.InvokeVoidAsync("legionTerm.write", termId, Convert.ToBase64String(ms.ToArray()));
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or ObjectDisposedException or TaskCanceledException) { }
    }

    private void Disconnect()
    {
        generation++; // invalidates the running pump
        if (session is not null)
        {
            if (listener is not null) session.Detach(listener);
            session.Exited -= OnSessionExited;
        }
        pump?.Writer.TryComplete();
        session = null;
        listener = null;
        pump = null;
    }

    private async Task StopAsync()
    {
        Disconnect();
        Sessions.Stop(Name);
        running = false;
        await Task.CompletedTask;
    }

    // New conversation. A running session is ended, so the first click only asks for confirmation.
    private async Task NewSessionAsync()
    {
        if (Sessions.IsRunning(Name) && !confirmNew)
        {
            confirmNew = true;
            return;
        }
        confirmNew = false;
        await RestartAsync(true);
    }

    private async Task RestartAsync(bool fresh)
    {
        confirmNew = false;
        Disconnect();
        Sessions.Stop(Name);
        await JS.InvokeVoidAsync("legionTerm.reset", termId);
        size = await JS.InvokeAsync<TermSize>("legionTerm.size", termId);
        await ConnectAsync(fresh);
        await JS.InvokeVoidAsync("legionTerm.focus", termId);
    }

    private static string ShortId(string id) => id.Length > 8 ? id[..8] : id;

    private void CloseEditor() => showEditor = false;

    // A renamed job lives under a new address: follow it (the page then connects the new name's session).
    private void OnEdited((string Name, CommandResult Result) e)
    {
        if (e.Name != Name) Nav.NavigateTo($"jobs/{e.Name}");
    }

    // The editor / terminal window opens on its own, so only a failure needs to be shown.
    private Task OpenEditorAsync() => LaunchAsync(Legion.OpenEditorAsync);

    // A plain shell in the job folder (a Windows Terminal tab), as opposed to the claude session shown below.
    private Task OpenShellAsync() => LaunchAsync(Legion.OpenTerminalAsync);

    private async Task LaunchAsync(Func<string, Task<CommandResult>> launch)
    {
        openingEditor = true;
        editorResult = null;
        try { editorResult = await launch(Name); }
        finally { openingEditor = false; }
    }

    private void OnSessionExited() => OnSessionsChanged();

    private void OnSessionsChanged()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            running = Sessions.IsRunning(Name);
            StateHasChanged();
        });
    }

    [JSInvokable]
    public void OnInput(string data) => session?.Write(data);

    [JSInvokable]
    public void OnResize(int cols, int rows)
    {
        size = new TermSize(cols, rows);
        session?.Resize(cols, rows);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        Sessions.Changed -= OnSessionsChanged;
        Store.Changed -= OnSessionsChanged;
        Disconnect(); // detaches the viewer only; the session keeps running
        try { await JS.InvokeVoidAsync("legionTerm.dispose", termId); }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException) { }
        self?.Dispose();
    }
}
