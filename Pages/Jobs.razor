@page "/jobs"
@using AgentLegion.Services
@implements IDisposable
@inject LegionService Legion
@inject JobStore Store
@inject SessionManager Sessions

<PageTitle>Jobs - AgentLegion</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h1 class="me-auto mb-0">Jobs</h1>
    <button class="btn btn-outline-primary" disabled="@(loading || busyJob is not null)" @onclick="RefreshAsync">
        @(loading ? "Loading..." : "Refresh")
    </button>
</div>

@if (!Store.IsConfigured)
{
    <div class="alert alert-info" role="alert">
        먼저 <a href="settings">Settings</a>에서 WSL 배포판과 기본 repo를 설정하세요.
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6 card-title">Add job</h2>
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1" for="newName">Name</label>
                    <input id="newName" class="form-control" @bind="newName" @bind:event="oninput" placeholder="job1" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1" for="newEnv">Environment</label>
                    <select id="newEnv" class="form-select" @bind="newEnv" title="WSL: claude runs in the Linux distro. Windows: claude runs in Windows PowerShell (e.g. Unity projects).">
                        <option value="wsl">WSL</option>
                        <option value="windows">Windows PowerShell</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1" for="newBranch">Branch (optional)</label>
                    <input id="newBranch" class="form-control" @bind="newBranch" placeholder="@(string.IsNullOrWhiteSpace(newName) ? "agent/<name>" : $"agent/{newName.Trim()}")" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1" for="newRepo">Repo (optional)</label>
                    <input id="newRepo" class="form-control" @bind="newRepo" placeholder="기본 repo 사용" />
                </div>
                <div class="col-12 col-md-2">
                    <button class="btn btn-success w-100" disabled="@(busyJob is not null || string.IsNullOrWhiteSpace(newName))" @onclick="AddJobAsync">
                        @(busyAction == "Add" ? "Adding..." : "Add")
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (Store.Error is not null)
    {
        <div class="alert alert-danger" role="alert">@Store.Error</div>
    }
    else if (!Store.Loaded)
    {
        <p><em>Loading...</em></p>
    }
    else if (Store.Jobs.Count == 0)
    {
        <p class="text-muted">No jobs yet. 위의 Add job 폼으로 만들 수 있습니다.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Job</th><th>Env</th><th>Branch</th><th>Changes</th><th>Session</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var j in Store.Jobs)
                    {
                        var busy = busyJob is not null;
                        var state = Sessions.GetState(j.Job);
                        var live = state != SessionState.Stopped;
                        <tr>
                            <td><a href="@($"jobs/{j.Job}")">@j.Job</a></td>
                            <td><span class="badge @(j.IsWindows ? "bg-info text-dark" : "bg-light text-dark border")" title="@(j.Path)">@(j.IsWindows ? "PowerShell" : "WSL")</span></td>
                            <td><code>@j.Branch</code></td>
                            <td>
                                @if (j.Changes == 0)
                                {
                                    <span class="badge bg-success">clean</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@j.Changes modified</span>
                                }
                            </td>
                            <td>
                                <span class="badge @StateBadge(state)">@state.Label()</span>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (busyJob == j.Job)
                                {
                                    <span class="text-muted me-2">@busyAction...</span>
                                }
                                <a class="btn btn-sm btn-primary" href="@($"jobs/{j.Job}")">Open</a>
                                @if (live)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => StopSession(j.Job)">Stop</button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => DiffJob(j.Job)">Diff</button>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => PushJob(j.Job)">Push</button>
                                @if (confirmRemove == j.Job)
                                {
                                    <button class="btn btn-sm btn-danger" disabled="@busy" @onclick="() => RemoveAsync(j.Job)">Confirm remove</button>
                                    <button class="btn btn-sm btn-link" @onclick="() => confirmRemove = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="() => confirmRemove = j.Job">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@if (result is not null)
{
    <div class="card mt-3">
        <div class="card-header d-flex align-items-center">
            <span class="me-auto">
                <span class="badge @(result.Ok ? "bg-success" : "bg-danger") me-2">@(result.Ok ? "OK" : "Failed")</span>
                @resultTitle
            </span>
            <button class="btn btn-sm btn-link" @onclick="() => result = null">Close</button>
        </div>
        <pre class="card-body mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(result.Output) ? "(no output)" : result.Output)</pre>
    </div>
}

@code {
    private static string StateBadge(SessionState s) => s switch
    {
        SessionState.Working => "bg-primary",
        SessionState.Waiting => "bg-warning text-dark",
        _ => "bg-secondary",
    };

    private bool loading;
    private bool disposed;

    private string? busyJob;
    private string? busyAction;
    private string? confirmRemove;
    private CommandResult? result;
    private string? resultTitle;

    private string newName = "";
    private string newEnv = "wsl";
    private string? newBranch;
    private string? newRepo;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnExternalChange;
        Sessions.Changed += OnExternalChange;
        if (!Store.Loaded) await RefreshAsync();
    }

    private void OnExternalChange()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (!disposed) StateHasChanged();
        });
    }

    private async Task RefreshAsync()
    {
        loading = true;
        try { await Store.RefreshAsync(); }
        finally { loading = false; }
    }

    private async Task RunAsync(string job, string action, Func<string, Task<CommandResult>> call)
    {
        confirmRemove = null;
        busyJob = job;
        busyAction = action;
        try
        {
            result = await call(job);
            resultTitle = $"{action} {job}";
        }
        finally
        {
            busyJob = busyAction = null;
        }
    }

    private Task DiffJob(string job) => RunAsync(job, "Diff", Legion.DiffAsync);
    private Task PushJob(string job) => RunAsync(job, "Push", Legion.PushAsync);

    private void StopSession(string job) => Sessions.Stop(job);

    private async Task AddJobAsync()
    {
        var name = newName.Trim();
        await RunAsync(name, "Add", _ => Legion.AddJobAsync(name, newBranch, newRepo, newEnv == "windows"));
        if (result is { Ok: true })
        {
            newName = "";
            newBranch = newRepo = null;
            await RefreshAsync();
        }
    }

    private async Task RemoveAsync(string job)
    {
        if (Sessions.IsRunning(job))
        {
            confirmRemove = null;
            result = new CommandResult(false, "실행 중인 세션이 있습니다. 먼저 Stop으로 세션을 종료하세요.");
            resultTitle = $"Remove {job}";
            return;
        }

        await RunAsync(job, "Remove", Legion.RemoveAsync);
        if (result is { Ok: true }) await RefreshAsync();
    }

    public void Dispose()
    {
        disposed = true;
        Store.Changed -= OnExternalChange;
        Sessions.Changed -= OnExternalChange;
    }
}
