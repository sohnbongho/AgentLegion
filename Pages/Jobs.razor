@page "/jobs"
@using AgentLegion.Services
@implements IDisposable
@inject LegionService Legion
@inject JobStore Store
@inject SessionManager Sessions
@inject NavigationManager Nav
@inject GitAccountService Git

<PageTitle>Jobs - AgentLegion</PageTitle>

<div class="d-flex align-items-center mb-3">
    <h1 class="me-auto mb-0">Jobs</h1>
    @if (Store.Jobs.Any(j => !j.IsWindows))
    {
        <span class="me-2"><ServerStatusChip /></span>
    }
    <button class="btn btn-outline-primary" disabled="@(loading || busyJob is not null)" @onclick="RefreshAsync">
        @(loading ? "Loading..." : "Refresh")
    </button>
</div>

@if (!Store.IsConfigured)
{
    <div class="alert alert-info" role="alert">
        먼저 <a href="settings">Settings</a>에서 WSL 배포판과 기본 repo를 설정하세요.
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h6 card-title">Add job</h2>
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1" for="newName">Name</label>
                    <input id="newName" class="form-control" @bind="newName" @bind:event="oninput" placeholder="job1" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1" for="newEnv">Environment</label>
                    <select id="newEnv" class="form-select" @bind="newEnv" title="WSL: claude runs in the Linux distro. Windows: claude runs in Windows PowerShell (e.g. Unity projects).">
                        <option value="wsl">WSL</option>
                        <option value="windows">Windows PowerShell</option>
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1" for="newBranch">Branch (optional)</label>
                    <input id="newBranch" class="form-control" @bind="newBranch" placeholder="@(UsePath ? "현재 브랜치 유지" : string.IsNullOrWhiteSpace(newName) ? "agent/<name>" : $"agent/{newName.Trim()}")" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small mb-1" for="newRepo">Repo (optional)</label>
                    <input id="newRepo" class="form-control" @bind="newRepo" disabled="@UsePath" placeholder="@(UsePath ? "기존 폴더의 repo 사용" : "기본 repo 사용")" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small mb-1" for="newClaude">Claude name (optional)</label>
                    <input id="newClaude" class="form-control" @bind="newClaudeName"
                           title="claude --name 으로 쓰는 세션 이름. 다른 Claude 세션이 이 이름으로 메시지를 보냅니다."
                           placeholder="@(string.IsNullOrWhiteSpace(newName) ? "job 이름" : newName.Trim())" />
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label small mb-1" for="newPath">Path (optional)</label>
                    <input id="newPath" class="form-control" @bind="newPath" @bind:event="oninput"
                           title="이미 clone된 폴더를 지정하면 새로 받지 않고 그 폴더에서 git pull만 합니다."
                           placeholder="@(newEnv == "windows" ? @"D:\work\repo" : "/home/me/work/repo")" />
                </div>
                <div class="col-12 col-md-2">
                    <button class="btn btn-success w-100" disabled="@(busyJob is not null || string.IsNullOrWhiteSpace(newName))" @onclick="AddJobAsync">
                        @(busyAction == "Add" ? "Adding..." : "Add")
                    </button>
                </div>
            </div>
            @if (busyAction == "Add")
            {
                string[] lines;
                lock (addLog) lines = addLog.ToArray();
                <div class="small text-muted mt-3 mb-1">진행 상황 · @addElapsed</div>
                <pre class="add-progress mb-0">@(lines.Length == 0 ? "시작하는 중..." : string.Join("\n", lines))</pre>
            }
        </div>
    </div>

    @if (Store.Error is not null)
    {
        <div class="alert alert-danger" role="alert">@Store.Error</div>
    }
    else if (!Store.Loaded)
    {
        <p><em>Loading...</em></p>
    }
    else if (Store.Jobs.Count == 0)
    {
        <p class="text-muted">No jobs yet. 위의 Add job 폼으로 만들 수 있습니다.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr><th>Job</th><th>Claude name</th><th>Env</th><th>Branch</th><th>Changes</th><th>Session</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var j in Store.Jobs)
                    {
                        var busy = busyJob is not null;
                        var state = Sessions.GetState(j.Job);
                        var live = state != SessionState.Stopped;
                        <tr>
                            <td><a href="@($"jobs/{j.Job}")">@j.Job</a></td>
                            <td><code title="다른 Claude 세션에서 이 이름으로 메시지를 보냅니다">@j.SessionName</code></td>
                            <td><span class="badge @(j.IsWindows ? "bg-info text-dark" : "bg-light text-dark border")" title="@(j.Path)">@(j.IsWindows ? "PowerShell" : "WSL")</span></td>
                            <td><code>@j.Branch</code></td>
                            <td>
                                @if (j.Changes == 0)
                                {
                                    <span class="badge bg-success">clean</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@j.Changes modified</span>
                                }
                            </td>
                            <td>
                                <span class="badge @StateBadge(state)">@state.Label()</span>
                            </td>
                            <td class="text-end text-nowrap">
                                @if (busyJob == j.Job)
                                {
                                    <span class="text-muted me-2">@busyAction...</span>
                                }
                                <a class="btn btn-sm btn-primary" href="@($"jobs/{j.Job}")">Open</a>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => CodeJob(j.Job)" title="이 job 폴더에서 code . 실행">VS Code</button>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => ShellJob(j.Job)" title="이 job 폴더에서 일반 터미널(셸) 열기 - claude 아님">Terminal</button>
                                <button class="btn btn-sm @(editingJob == j.Job ? "btn-secondary" : "btn-outline-secondary")" disabled="@busy" @onclick="() => ToggleEdit(j.Job)" title="이름, 브랜치, repo, 작업 경로 수정">Edit</button>
                                @if (live)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => StopSession(j.Job)">Stop</button>
                                }
                                @if (confirmNew == j.Job)
                                {
                                    <button class="btn btn-sm btn-warning" disabled="@busy" @onclick="() => NewSession(j.Job)" title="실행 중인 세션을 종료하고 새 대화로 시작">종료 후 새 대화</button>
                                    <button class="btn btn-sm btn-link" @onclick="() => confirmNew = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-primary" disabled="@busy" @onclick="() => NewSession(j.Job)" title="새 대화로 시작하고 터미널을 엽니다">New session</button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => DiffJob(j.Job)">Diff</button>
                                <button class="btn btn-sm btn-outline-secondary" disabled="@busy" @onclick="() => PushJob(j.Job)">Push</button>
                                @if (confirmRemove == j.Job)
                                {
                                    <button class="btn btn-sm btn-danger" disabled="@busy" @onclick="() => RemoveAsync(j.Job)">Confirm remove</button>
                                    <button class="btn btn-sm btn-link" @onclick="() => confirmRemove = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="() => confirmRemove = j.Job">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>


        @if (editingJob is not null && Store.Jobs.FirstOrDefault(x => x.Job == editingJob) is { } editing)
        {
            <JobEditor Job="editing" OnSaved="OnEdited" OnClose="CloseEdit" />
        }
    }
}

@if (result is not null)
{
    <div class="card mt-3">
        <div class="card-header d-flex align-items-center">
            <span class="me-auto">
                <span class="badge @(result.Ok ? "bg-success" : "bg-danger") me-2">@(result.Ok ? "OK" : "Failed")</span>
                @resultTitle
            </span>
            <button class="btn btn-sm btn-link" @onclick="() => result = null">Close</button>
        </div>
        <pre class="card-body mb-0" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(result.Output) ? "(no output)" : result.Output)</pre>
    </div>
}

@if (login is { } prompt)
{
    <div class="modal d-block git-login" style="background: rgba(0, 0, 0, 0.45);" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="gitLoginTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="gitLoginTitle">Git 로그인</h5>
                    <button type="button" class="btn-close" aria-label="닫기" disabled="@prompt.Saving" @onclick="CancelLogin"></button>
                </div>
                <div class="modal-body">
                    <p class="small">
                        <code>@prompt.Remote.Scheme://@prompt.Remote.Authority</code>에 로그인하지 못했습니다 (저장된 계정이 없거나 토큰이 만료됨).
                        계정을 입력하면 저장한 뒤 <strong>@prompt.Title</strong>을 다시 실행합니다.
                    </p>
                    <div class="mb-2">
                        <label class="form-label small mb-1" for="loginUser">사용자 이름</label>
                        <input id="loginUser" class="form-control" @bind="prompt.User" @bind:event="oninput" autocomplete="off" spellcheck="false" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-1" for="loginToken">토큰 (또는 비밀번호)</label>
                        <input id="loginToken" type="password" class="form-control" @bind="prompt.Token" @bind:event="oninput" autocomplete="new-password" />
                    </div>
                    <div class="form-text">
                        비밀번호보다 액세스 토큰(GitLab: <code>read_repository</code>, <code>write_repository</code> 권한)을 권장합니다.
                        GitLab 토큰이면 사용자 이름은 <code>oauth2</code>여도 됩니다.
                        토큰은 앱에 저장하지 않고 git의 credential helper(WSL은 보통 <code>~/.git-credentials</code>, Windows는 Git Credential Manager)에 넣습니다.
                    </div>
                    @if (prompt.Error is not null)
                    {
                        <div class="alert alert-danger py-2 mt-2 mb-0 small" role="alert" style="white-space: pre-wrap;">@prompt.Error</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" disabled="@prompt.Saving" @onclick="CancelLogin">취소</button>
                    <button class="btn btn-primary" disabled="@(prompt.Saving || string.IsNullOrWhiteSpace(prompt.User) || string.IsNullOrEmpty(prompt.Token))"
                            @onclick="SaveLoginAsync">
                        @(prompt.Saving ? "저장 중..." : "저장 후 다시 시도")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static string StateBadge(SessionState s) => s switch
    {
        SessionState.Working => "bg-primary",
        SessionState.Waiting => "bg-warning text-dark",
        _ => "bg-secondary",
    };

    private bool loading;
    private bool disposed;

    private string? busyJob;
    private string? busyAction;
    private string? confirmRemove;
    private string? confirmNew;

    // Start a fresh conversation for the job and open its terminal. Ending a running session asks first.
    private void NewSession(string job)
    {
        if (Sessions.IsRunning(job) && confirmNew != job)
        {
            confirmNew = job;
            return;
        }
        confirmNew = null;
        confirmRemove = null;
        try
        {
            Sessions.Stop(job);
            Sessions.GetOrStart(job, 120, 30, null); // no resume id: a new conversation; the terminal page attaches and resizes
        }
        catch (Exception ex)
        {
            result = new CommandResult(false, ex.Message);
            resultTitle = $"New session {job}";
            return;
        }
        Nav.NavigateTo($"jobs/{job}");
    }
    private string? editingJob;

    private void ToggleEdit(string job) => editingJob = editingJob == job ? null : job;

    private void CloseEdit() => editingJob = null;

    // keep the editor open on the (possibly renamed) job so the result stays visible
    private void OnEdited((string Name, CommandResult Result) e)
    {
        editingJob = e.Name;
        result = e.Result;
        resultTitle = $"Edit {e.Name}";
    }
    private CommandResult? result;
    private string? resultTitle;

    private string newName = "";
    private string newEnv = "wsl";
    private string? newBranch;
    private string? newRepo;
    private string? newPath;
    private string? newClaudeName;
    private bool UsePath => !string.IsNullOrWhiteSpace(newPath);

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnExternalChange;
        Sessions.Changed += OnExternalChange;
        if (!Store.Loaded) await RefreshAsync();
    }

    private void OnExternalChange()
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (!disposed) StateHasChanged();
        });
    }

    private async Task RefreshAsync()
    {
        loading = true;
        try { await Store.RefreshAsync(); }
        finally { loading = false; }
    }

    /// <param name="retry">Runs the action again; given, a failed git login asks for the account and then retries.</param>
    private async Task RunAsync(string job, string action, Func<string, Task<CommandResult>> call, Func<Task>? retry = null)
    {
        confirmRemove = null;
        busyJob = job;
        busyAction = action;
        try
        {
            result = await call(job);
            resultTitle = $"{action} {job}";
        }
        finally
        {
            busyJob = busyAction = null;
        }
        if (retry is not null && result is { Ok: false } && GitAccountService.FailedLoginRemote(result.Output) is { } remote)
            await AskLoginAsync(remote, $"{action} {job}", retry);
    }

    private Task CodeJob(string job) => RunAsync(job, "VS Code", Legion.OpenEditorAsync);
    private Task ShellJob(string job) => RunAsync(job, "Terminal", Legion.OpenTerminalAsync);
    private Task DiffJob(string job) => RunAsync(job, "Diff", Legion.DiffAsync);
    private Task PushJob(string job) => RunAsync(job, "Push", Legion.PushAsync, () => PushJob(job));

    // ---- git login, asked for when a clone / pull / push could not log in ----
    private sealed class LoginPrompt
    {
        public required Uri Remote { get; init; }
        public required string Title { get; init; }
        public required Func<Task> Retry { get; init; }
        public string? User { get; set; }
        public string? Token { get; set; }   // only held until it is handed to git
        public bool Saving { get; set; }
        public string? Error { get; set; }
    }

    private LoginPrompt? login;

    private async Task AskLoginAsync(Uri remote, string title, Func<Task> retry)
    {
        var prompt = new LoginPrompt { Remote = remote, Title = title, Retry = retry };
        login = prompt;
        StateHasChanged();
        // the account git still has (its token expired, most likely) prefills the user name
        var stored = await Git.GetStoredUserAsync(remote);
        if (login == prompt && string.IsNullOrEmpty(prompt.User)) prompt.User = stored;
    }

    private void CancelLogin() => login = null;

    private async Task SaveLoginAsync()
    {
        if (login is not { } prompt) return;
        var token = prompt.Token ?? "";
        prompt.Token = null;
        prompt.Saving = true;
        prompt.Error = null;
        try
        {
            var r = await Git.SaveAsync(prompt.Remote, prompt.User ?? "", token);
            if (!r.Ok)
            {
                prompt.Error = r.Output;
                return;
            }
        }
        finally
        {
            prompt.Saving = false;
        }
        login = null;
        await prompt.Retry();
    }

    private void StopSession(string job) => Sessions.Stop(job);

    private readonly List<string> addLog = new(); // the running add's output, filled from the process's reader threads
    private string addElapsed = "";
    private bool addRenderPending;

    private void OnAddLine(string line)
    {
        lock (addLog)
        {
            LegionService.AppendOutputLine(addLog, line);
            if (addRenderPending) return;
            addRenderPending = true;
        }
        // clone progress arrives many times a second: redraw at most every 200 ms
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(200);
            lock (addLog) addRenderPending = false;
            if (!disposed) StateHasChanged();
        });
    }

    private async Task AddJobAsync()
    {
        var name = newName.Trim();
        lock (addLog) addLog.Clear();
        var started = DateTime.UtcNow;
        using var ticker = new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            addElapsed = $"{(DateTime.UtcNow - started).TotalSeconds:0}초";
            if (!disposed) StateHasChanged();
        }), null, 0, 1000);
        await RunAsync(name, "Add", _ => Legion.AddJobAsync(name, newBranch, newRepo, newEnv == "windows", newPath, newClaudeName, OnAddLine),
            AddJobAsync);
        if (result is { Ok: true })
        {
            newName = "";
            newBranch = newRepo = newPath = newClaudeName = null;
            await RefreshAsync();
        }
    }

    private async Task RemoveAsync(string job)
    {
        if (Sessions.IsRunning(job))
        {
            confirmRemove = null;
            result = new CommandResult(false, "실행 중인 세션이 있습니다. 먼저 Stop으로 세션을 종료하세요.");
            resultTitle = $"Remove {job}";
            return;
        }

        await RunAsync(job, "Remove", Legion.RemoveAsync);
        if (result is { Ok: true }) await RefreshAsync();
    }

    public void Dispose()
    {
        disposed = true;
        Store.Changed -= OnExternalChange;
        Sessions.Changed -= OnExternalChange;
    }
}
