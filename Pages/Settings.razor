@page "/settings"
@using AgentLegion.Services
@inject LegionService Legion
@inject JobStore Store
@inject GitAccountService Git

<PageTitle>Settings - AgentLegion</PageTitle>

<h1>Settings</h1>

@if (!Legion.IsConfigured)
{
    <div class="alert alert-info" role="alert">
        아직 설정이 없습니다. 아래 값을 입력하고 저장하면 <code>legion.json</code>이 만들어집니다.
    </div>
}

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="distro">WSL distribution</label>
    <input id="distro" class="form-control" list="distro-list" @bind="distro" placeholder="비워두면 기본 배포판" />
    <datalist id="distro-list">
        @foreach (var d in distros)
        {
            <option value="@d"></option>
        }
    </datalist>
    <div class="form-text">claude와 git이 설치된 배포판. 설치된 목록: @(distros.Count == 0 ? "(조회 실패)" : string.Join(", ", distros))</div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="root">Jobs root (WSL 경로)</label>
    <input id="root" class="form-control" @bind="jobsRoot" />
    <div class="form-text">각 job이 <code>&lt;root&gt;/&lt;job&gt;</code>에 clone됩니다.</div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="claudecmd">Claude 명령 (WSL)</label>
    <div class="input-group">
        <input id="claudecmd" class="form-control" @bind="claudeCmd" placeholder="claude" />
        <button class="btn btn-outline-secondary" disabled="@finding" @onclick="FindClaudeAsync">@(finding ? "찾는 중..." : "WSL에서 찾기")</button>
    </div>
    <div class="form-text">
        WSL job에서 실행할 명령. 이름 대신 절대 경로(예: <code>/home/me/.local/bin/claude</code>)를 넣을 수 있습니다.
        인자를 덧붙여도 됩니다(예: <code>claude --model opus</code>).
    </div>
    @if (foundMessage is not null)
    {
        <div class="alert @(foundIsWindows || foundPath is null ? "alert-warning" : "alert-secondary") py-2 mt-2 mb-0 small" role="alert">
            @foundMessage
            @if (foundPath is not null && !foundIsWindows && foundPath != claudeCmd?.Trim())
            {
                <button class="btn btn-link btn-sm p-0 ms-2 align-baseline" @onclick="() => claudeCmd = foundPath">이 경로 사용</button>
            }
        </div>
    }
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="winroot">Jobs root (Windows PowerShell)</label>
    <input id="winroot" class="form-control" @bind="windowsRoot" placeholder="@LegionConfig.DefaultWindowsRoot" />
    <div class="form-text">
        Windows PowerShell job(예: Unity 작업)이 <code>&lt;root&gt;\&lt;job&gt;</code>에 clone됩니다. 비워두면 <code>@LegionConfig.DefaultWindowsRoot</code>.
        Windows에 <code>git</code>과 <code>claude</code>가 설치되어 있어야 합니다.
    </div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="winclaudecmd">Claude 명령 (Windows PowerShell)</label>
    <input id="winclaudecmd" class="form-control" @bind="windowsClaudeCmd" placeholder="claude" />
    <div class="form-text">Windows PowerShell job에서 실행할 명령. 절대 경로(예: <code>C:\Users\me\AppData\Roaming\npm\claude.cmd</code>)도 됩니다.</div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="repo">Default repo</label>
    <input id="repo" class="form-control" @bind="repo" placeholder="git@github.com:me/proj.git" />
    <div class="form-text">URL 또는 WSL 절대경로(<code>~</code>는 사용할 수 없음). job마다 따로 지정할 수도 있습니다.</div>
</div>

<h2 class="h5 mt-4">Git 계정</h2>

<div class="mb-3" style="max-width: 36rem;">
    @if (GitRemote is not { } remote)
    {
        <div class="form-text mt-0">
            Default repo가 HTTPS 주소가 아니라서(SSH 키 또는 로컬 경로) 여기서 넣을 계정이 없습니다.
        </div>
    }
    else
    {
        <p class="form-text mt-0">
            job 추가(clone · pull)와 Push가 <code>@remote.Scheme://@remote.Authority</code>에 로그인할 때 쓰는 계정입니다.
            계정이 없거나 토큰이 만료되면 git이 묻지 않고 바로 실패하므로, 여기서 새 토큰을 저장하세요.
        </p>
        <div class="small mb-2">
            저장된 계정:
            @if (gitLoading)
            {
                <span class="text-muted">확인 중...</span>
            }
            else if (gitState is not null)
            {
                <span class="me-3">WSL <strong>@(gitState.WslUser ?? "없음")</strong></span>
                <span>Windows <strong>@(gitState.WindowsNote ?? gitState.WindowsUser ?? "없음")</strong></span>
            }
        </div>
        <div class="row g-2">
            <div class="col-5">
                <label class="form-label" for="gituser">사용자 이름</label>
                <input id="gituser" class="form-control" @bind="gitUser" autocomplete="off" spellcheck="false" />
            </div>
            <div class="col-7">
                <label class="form-label" for="gittoken">토큰 (또는 비밀번호)</label>
                <input id="gittoken" type="password" class="form-control" @bind="gitToken" @bind:event="oninput" autocomplete="new-password" />
            </div>
        </div>
        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-outline-primary btn-sm" disabled="@(gitBusy || string.IsNullOrWhiteSpace(gitUser) || string.IsNullOrEmpty(gitToken))" @onclick="SaveGitAccountAsync">계정 저장</button>
            <button class="btn btn-outline-secondary btn-sm" disabled="@gitBusy" @onclick="TestGitAsync">연결 확인</button>
            @if (confirmGitDelete)
            {
                <button class="btn btn-danger btn-sm ms-auto" disabled="@gitBusy" @onclick="DeleteGitAccountAsync">정말 삭제</button>
                <button class="btn btn-link btn-sm" @onclick="() => confirmGitDelete = false">취소</button>
            }
            else
            {
                <button class="btn btn-outline-danger btn-sm ms-auto" disabled="@gitBusy" @onclick="() => confirmGitDelete = true">저장된 계정 삭제</button>
            }
        </div>
        @if (gitBusy)
        {
            <div class="form-text">git을 실행하는 중...</div>
        }
        @if (gitResult is not null)
        {
            <div class="alert @(gitResult.Ok ? "alert-success" : "alert-danger") py-2 mt-2 mb-0 small" role="alert" style="white-space: pre-wrap;">@gitResult.Output</div>
        }
        <div class="form-text">
            비밀번호보다 액세스 토큰(GitLab: <code>read_repository</code>, <code>write_repository</code> 권한)을 권장합니다.
            토큰은 legion.json에 저장하지 않고 git의 credential helper에 바로 넣습니다.
            WSL은 보통 <code>store</code>(<code>~/.git-credentials</code>, 평문 파일), Windows는 Git Credential Manager입니다.
            이 버튼은 위의 Save와 별개로 바로 적용됩니다.
        </div>
    }
</div>

<h2 class="h5 mt-4">Job 터미널</h2>

<div class="row g-2 mb-2" style="max-width: 36rem;">
    <div class="col-8">
        <label class="form-label" for="termfont">글꼴</label>
        <input id="termfont" class="form-control" list="termfont-list" @bind="termFontFamily" @bind:event="oninput" placeholder="Consolas (기본)" />
        <datalist id="termfont-list">
            @foreach (var f in fontSuggestions)
            {
                <option value="@f"></option>
            }
        </datalist>
    </div>
    <div class="col-4">
        <label class="form-label" for="termsize">크기 (px)</label>
        <input id="termsize" type="number" class="form-control" min="@LegionConfig.MinTerminalFontSize" max="@LegionConfig.MaxTerminalFontSize"
               @bind="termFontSize" @bind:event="oninput" />
    </div>
</div>
<div class="mb-3" style="max-width: 36rem;">
    <div class="terminal-font-preview" style="@PreviewStyle">claude&gt; 안녕하세요 Hello 0123456789 {}[]()</div>
    <div class="form-text">
        PC에 설치된 글꼴 이름을 입력합니다. 없는 글꼴이면 Consolas로 표시됩니다.
        크기는 @LegionConfig.MinTerminalFontSize~@LegionConfig.MaxTerminalFontSize. 저장 후 job 화면을 다시 열면 적용됩니다.
    </div>
</div>

<h2 class="h5 mt-4">서버 빌드 · 배포 (WSL job)</h2>
<p class="form-text mt-0" style="max-width: 36rem;">
    WSL job 화면의 <strong>Build / Deploy / Stop / Run</strong> 버튼이 쓰는 값입니다. 비워두면 기본값을 씁니다.
</p>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="deployroot">기본 배포 경로</label>
    <input id="deployroot" class="form-control font-monospace" @bind="deployRoot" placeholder="@LegionConfig.DefaultDeployRoot" spellcheck="false" />
    <div class="form-text">
        Deploy가 job 폴더의 <code>@LegionConfig.DeployFile</code>를 복사할 WSL 폴더이자 Run이 서버를 띄우는 폴더(<code>WIND_HOME</code>).
        job 화면에서 job마다 따로 바꿀 수 있고, 바꾸지 않은 job은 이 값을 씁니다.
    </div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="buildcmd">빌드 명령</label>
    <input id="buildcmd" class="form-control font-monospace" @bind="buildCmd" placeholder="@LegionConfig.DefaultBuildCmd" spellcheck="false" />
    <div class="form-text">
        Build가 job 폴더에서 실행하는 명령. wind 서버의 <code>make</code>는 <code>make all</code>(clean 후 전체 빌드)이고,
        <code>make wind</code>는 바뀐 파일만 다시 빌드합니다.
    </div>
</div>

<div class="row g-2 mb-3" style="max-width: 36rem;">
    <div class="col-8">
        <label class="form-label" for="scriptdir">서버 스크립트 폴더</label>
        <input id="scriptdir" class="form-control font-monospace" @bind="serverScriptDir" placeholder="@LegionConfig.DefaultServerScriptDir" spellcheck="false" />
    </div>
    <div class="col-4">
        <label class="form-label" for="session">tmux 세션</label>
        <input id="session" class="form-control font-monospace" @bind="serverSession" placeholder="@LegionConfig.DefaultServerSession" spellcheck="false" />
    </div>
    <div class="col-12 form-text mt-1">
        Stop은 <code>stop_wind_server.sh</code>, Run은 <code>run_gameserver.sh</code>를 이 폴더에서 실행합니다.
        Run은 스크립트의 <code>WIND_HOME</code>을 배포 경로로 바꾸고 마지막 <code>tmux attach</code>는 빼고 실행합니다.
    </div>
</div>

<h2 class="h5 mt-4">로그 (Logs 탭)</h2>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="logroot">기본 로그 폴더</label>
    <input id="logroot" class="form-control font-monospace" @bind="logRoot" placeholder="@LegionConfig.DefaultLogRoot" spellcheck="false" />
    <div class="form-text">
        Logs 탭이 처음 여는 WSL 폴더이자 트리의 <span class="oi oi-home" aria-hidden="true"></span> 버튼이 가는 폴더.
        바꾸면 다음에 Logs 탭을 열 때 이 폴더가 열립니다.
    </div>
</div>

<h2 class="h5 mt-4">Jobs 순서</h2>

<div class="mb-3" style="max-width: 36rem;">
    @if (!Store.Loaded)
    {
        <div class="form-text">job 목록을 불러오는 중...</div>
    }
    else if (jobOrder.Count == 0)
    {
        <div class="form-text">아직 job이 없습니다.</div>
    }
    else
    {
        <ol class="list-group list-group-numbered">
            @for (var i = 0; i < jobOrder.Count; i++)
            {
                var index = i;
                var j = jobOrder[i];
                <li class="list-group-item d-flex align-items-center gap-2 py-1">
                    <span class="me-auto">@j.Job</span>
                    <span class="badge @(j.IsWindows ? "bg-info text-dark" : "bg-light text-dark border")">@(j.IsWindows ? "PowerShell" : "WSL")</span>
                    <button class="btn btn-sm btn-outline-secondary py-0" title="위로" disabled="@(index == 0)" @onclick="() => MoveJob(index, -1)">
                        <span class="oi oi-arrow-top" aria-hidden="true"></span>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary py-0" title="아래로" disabled="@(index == jobOrder.Count - 1)" @onclick="() => MoveJob(index, 1)">
                        <span class="oi oi-arrow-bottom" aria-hidden="true"></span>
                    </button>
                </li>
            }
        </ol>
        <div class="d-flex align-items-start gap-2 mt-1">
            <div class="form-text mt-0 me-auto">
                사이드바와 Jobs 목록이 이 순서로 표시됩니다. Save를 눌러야 적용됩니다.
                순서를 정한 뒤 새로 추가한 job은 맨 아래에 이름순으로 붙습니다.
            </div>
            <button class="btn btn-sm btn-link py-0 text-nowrap" @onclick="SortJobsByName">이름순으로</button>
        </div>
    }
</div>

<button class="btn btn-primary" disabled="@(saving || string.IsNullOrWhiteSpace(repo) || string.IsNullOrWhiteSpace(jobsRoot))" @onclick="SaveAsync">
    @(saving ? "Saving..." : "Save")
</button>

@if (result is not null)
{
    <div class="alert @(result.Ok ? "alert-success" : "alert-danger") mt-3" role="alert">
        @if (result.Ok)
        {
            <span>저장했습니다. </span><a href="jobs">Jobs로 이동</a>
        }
        else
        {
            @result.Output
        }
    </div>
}

@code {
    private string? distro;
    private string jobsRoot = "~/agentjobs";
    private string windowsRoot = "";
    private string repo = "";
    private string? claudeCmd = "claude";
    private string? windowsClaudeCmd = "claude";
    private IReadOnlyList<string> distros = Array.Empty<string>();
    private bool saving;
    private CommandResult? result;
    private bool finding;
    private string? foundPath;
    private bool foundIsWindows;
    private string? foundMessage;
    private string? termFontFamily;
    private int termFontSize = LegionConfig.DefaultTerminalFontSize;
    private string? deployRoot = LegionConfig.DefaultDeployRoot;
    private string? buildCmd = LegionConfig.DefaultBuildCmd;
    private string? serverScriptDir = LegionConfig.DefaultServerScriptDir;
    private string? serverSession = LegionConfig.DefaultServerSession;
    private string? logRoot = LegionConfig.DefaultLogRoot;
    private List<JobInfo> jobOrder = new();
    private bool jobOrderChanged; // untouched, nothing is saved: new jobs keep falling into name order
    private string? gitUser;
    private string? gitToken;   // only held until it is handed to git
    private GitAccountState? gitState;
    private bool gitLoading;
    private bool gitBusy;
    private CommandResult? gitResult;
    private bool confirmGitDelete;

    // the host comes from the Default repo field as typed
    private Uri? GitRemote => GitAccountService.HttpsRemote(repo);

    private static readonly string[] fontSuggestions =
    {
        "Consolas", "Cascadia Mono", "Cascadia Code", "D2Coding", "JetBrains Mono", "NanumGothicCoding", "Courier New",
    };

    private const string DefaultTerminalFonts = "Consolas, \"Cascadia Mono\", \"Courier New\", monospace";

    private string PreviewStyle
    {
        get
        {
            var family = string.IsNullOrWhiteSpace(termFontFamily) ? DefaultTerminalFonts : $"{termFontFamily.Trim()}, {DefaultTerminalFonts}";
            var px = Math.Clamp(termFontSize, LegionConfig.MinTerminalFontSize, LegionConfig.MaxTerminalFontSize);
            return $"font-family: {family}; font-size: {px}px;";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var cfg = Legion.LoadConfig();
        if (cfg is not null)
        {
            distro = cfg.Distro;
            jobsRoot = cfg.JobsRoot;
            windowsRoot = cfg.WindowsJobsRoot ?? "";
            repo = cfg.Repo;
            claudeCmd = cfg.ClaudeCmd;
            windowsClaudeCmd = cfg.WindowsClaudeCmd;
            termFontFamily = cfg.TerminalFontFamily;
            termFontSize = cfg.TerminalFontSize;
            deployRoot = cfg.DeployRoot;
            buildCmd = cfg.BuildCmd;
            serverScriptDir = cfg.ServerScriptDir;
            serverSession = cfg.ServerSession;
            logRoot = cfg.LogRoot;
        }
        var loadJobs = Store.EnsureLoadedAsync();
        var loadGit = LoadGitStateAsync();
        distros = await Legion.GetDistrosAsync();
        await loadJobs;
        jobOrder = Store.Jobs.ToList();
        await loadGit;
    }

    private async Task LoadGitStateAsync()
    {
        if (GitRemote is not { } remote) return;
        gitLoading = true;
        try
        {
            gitState = await Git.GetStateAsync(remote);
            gitUser ??= gitState.WslUser ?? gitState.WindowsUser;
        }
        finally
        {
            gitLoading = false;
        }
    }

    private async Task RunGitAsync(Func<Uri, Task<CommandResult>> action)
    {
        if (GitRemote is not { } remote) return;
        gitBusy = true;
        gitResult = null;
        try
        {
            gitResult = await action(remote);
            await LoadGitStateAsync();
        }
        finally
        {
            gitBusy = false;
        }
    }

    private async Task SaveGitAccountAsync()
    {
        var token = gitToken ?? "";
        gitToken = null; // never kept on the page after saving
        await RunGitAsync(remote => Git.SaveAsync(remote, gitUser ?? "", token));
    }

    private Task TestGitAsync() => RunGitAsync(Git.TestAsync);

    private Task DeleteGitAccountAsync()
    {
        confirmGitDelete = false;
        return RunGitAsync(Git.DeleteAsync);
    }

    private void MoveJob(int index, int delta)
    {
        var to = index + delta;
        if (to < 0 || to >= jobOrder.Count) return;
        (jobOrder[index], jobOrder[to]) = (jobOrder[to], jobOrder[index]);
        jobOrderChanged = true;
    }

    private void SortJobsByName()
    {
        jobOrder = jobOrder.OrderBy(j => j.Job, StringComparer.OrdinalIgnoreCase).ToList();
        jobOrderChanged = true;
    }

    private async Task SaveAsync()
    {
        saving = true;
        result = null;
        try
        {
            result = await Legion.SaveConfigAsync(distro, jobsRoot, repo, windowsRoot,
                string.IsNullOrWhiteSpace(claudeCmd) ? "claude" : claudeCmd,
                string.IsNullOrWhiteSpace(windowsClaudeCmd) ? "claude" : windowsClaudeCmd);
            if (result.Ok) result = Legion.SaveTerminalFont(termFontFamily, termFontSize);
            if (result.Ok) result = Legion.SaveServerSettings(deployRoot, buildCmd, serverScriptDir, serverSession);
            if (result.Ok) result = Legion.SaveLogRoot(logRoot);
            if (result.Ok && jobOrderChanged)
            {
                // name order is the default, so it is saved as no order at all
                var byName = jobOrder.Select(j => j.Job).SequenceEqual(jobOrder.Select(j => j.Job).OrderBy(n => n, StringComparer.OrdinalIgnoreCase));
                result = Legion.SaveJobOrder(byName ? Array.Empty<string>() : jobOrder.Select(j => j.Job));
                if (result.Ok) jobOrderChanged = false;
            }
            if (result.Ok) await Store.RefreshAsync(); // sidebar picks up the new config
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>Shows which program the WSL login shell would actually run for the command.</summary>
    private async Task FindClaudeAsync()
    {
        finding = true;
        foundMessage = null;
        try
        {
            var cmd = string.IsNullOrWhiteSpace(claudeCmd) ? "claude" : claudeCmd;
            foundPath = await Legion.FindWslProgramAsync(distro, cmd);
            // WSL appends the Windows PATH, so without a Linux install `claude` resolves to the Windows one under /mnt/
            foundIsWindows = foundPath?.StartsWith("/mnt/") == true;
            foundMessage = foundPath is null
                ? "WSL에서 찾지 못했습니다. WSL 안에 Claude Code를 설치하세요: curl -fsSL https://claude.ai/install.sh | bash"
                : foundIsWindows
                    ? $"{foundPath} → Windows용 claude입니다. 이대로면 PowerShell 환경에서 실행됩니다. WSL 안에 Claude Code를 설치한 뒤 그 경로를 지정하세요."
                    : $"실행 파일: {foundPath}";
        }
        finally
        {
            finding = false;
        }
    }
}
