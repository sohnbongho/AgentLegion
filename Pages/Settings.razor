@page "/settings"
@using AgentLegion.Services
@inject LegionService Legion
@inject JobStore Store

<PageTitle>Settings - AgentLegion</PageTitle>

<h1>Settings</h1>

@if (!Legion.IsConfigured)
{
    <div class="alert alert-info" role="alert">
        아직 설정이 없습니다. 아래 값을 입력하고 저장하면 <code>legion.json</code>이 만들어집니다.
    </div>
}

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="distro">WSL distribution</label>
    <input id="distro" class="form-control" list="distro-list" @bind="distro" placeholder="비워두면 기본 배포판" />
    <datalist id="distro-list">
        @foreach (var d in distros)
        {
            <option value="@d"></option>
        }
    </datalist>
    <div class="form-text">claude와 git이 설치된 배포판. 설치된 목록: @(distros.Count == 0 ? "(조회 실패)" : string.Join(", ", distros))</div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="root">Jobs root (WSL 경로)</label>
    <input id="root" class="form-control" @bind="jobsRoot" />
    <div class="form-text">각 job이 <code>&lt;root&gt;/&lt;job&gt;</code>에 clone됩니다.</div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="claudecmd">Claude 명령 (WSL)</label>
    <div class="input-group">
        <input id="claudecmd" class="form-control" @bind="claudeCmd" placeholder="claude" />
        <button class="btn btn-outline-secondary" disabled="@finding" @onclick="FindClaudeAsync">@(finding ? "찾는 중..." : "WSL에서 찾기")</button>
    </div>
    <div class="form-text">
        WSL job에서 실행할 명령. 이름 대신 절대 경로(예: <code>/home/me/.local/bin/claude</code>)를 넣을 수 있습니다.
        인자를 덧붙여도 됩니다(예: <code>claude --model opus</code>).
    </div>
    @if (foundMessage is not null)
    {
        <div class="alert @(foundIsWindows || foundPath is null ? "alert-warning" : "alert-secondary") py-2 mt-2 mb-0 small" role="alert">
            @foundMessage
            @if (foundPath is not null && !foundIsWindows && foundPath != claudeCmd?.Trim())
            {
                <button class="btn btn-link btn-sm p-0 ms-2 align-baseline" @onclick="() => claudeCmd = foundPath">이 경로 사용</button>
            }
        </div>
    }
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="winroot">Jobs root (Windows PowerShell)</label>
    <input id="winroot" class="form-control" @bind="windowsRoot" placeholder="@LegionConfig.DefaultWindowsRoot" />
    <div class="form-text">
        Windows PowerShell job(예: Unity 작업)이 <code>&lt;root&gt;\&lt;job&gt;</code>에 clone됩니다. 비워두면 <code>@LegionConfig.DefaultWindowsRoot</code>.
        Windows에 <code>git</code>과 <code>claude</code>가 설치되어 있어야 합니다.
    </div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="winclaudecmd">Claude 명령 (Windows PowerShell)</label>
    <input id="winclaudecmd" class="form-control" @bind="windowsClaudeCmd" placeholder="claude" />
    <div class="form-text">Windows PowerShell job에서 실행할 명령. 절대 경로(예: <code>C:\Users\me\AppData\Roaming\npm\claude.cmd</code>)도 됩니다.</div>
</div>

<div class="mb-3" style="max-width: 36rem;">
    <label class="form-label" for="repo">Default repo</label>
    <input id="repo" class="form-control" @bind="repo" placeholder="git@github.com:me/proj.git" />
    <div class="form-text">URL 또는 WSL 절대경로(<code>~</code>는 사용할 수 없음). job마다 따로 지정할 수도 있습니다.</div>
</div>

<button class="btn btn-primary" disabled="@(saving || string.IsNullOrWhiteSpace(repo) || string.IsNullOrWhiteSpace(jobsRoot))" @onclick="SaveAsync">
    @(saving ? "Saving..." : "Save")
</button>

@if (result is not null)
{
    <div class="alert @(result.Ok ? "alert-success" : "alert-danger") mt-3" role="alert">
        @if (result.Ok)
        {
            <span>저장했습니다. </span><a href="jobs">Jobs로 이동</a>
        }
        else
        {
            @result.Output
        }
    </div>
}

@code {
    private string? distro;
    private string jobsRoot = "~/agentjobs";
    private string windowsRoot = "";
    private string repo = "";
    private string? claudeCmd = "claude";
    private string? windowsClaudeCmd = "claude";
    private IReadOnlyList<string> distros = Array.Empty<string>();
    private bool saving;
    private CommandResult? result;
    private bool finding;
    private string? foundPath;
    private bool foundIsWindows;
    private string? foundMessage;

    protected override async Task OnInitializedAsync()
    {
        var cfg = Legion.LoadConfig();
        if (cfg is not null)
        {
            distro = cfg.Distro;
            jobsRoot = cfg.JobsRoot;
            windowsRoot = cfg.WindowsJobsRoot ?? "";
            repo = cfg.Repo;
            claudeCmd = cfg.ClaudeCmd;
            windowsClaudeCmd = cfg.WindowsClaudeCmd;
        }
        distros = await Legion.GetDistrosAsync();
    }

    private async Task SaveAsync()
    {
        saving = true;
        result = null;
        try
        {
            result = await Legion.SaveConfigAsync(distro, jobsRoot, repo, windowsRoot,
                string.IsNullOrWhiteSpace(claudeCmd) ? "claude" : claudeCmd,
                string.IsNullOrWhiteSpace(windowsClaudeCmd) ? "claude" : windowsClaudeCmd);
            if (result.Ok) await Store.RefreshAsync(); // sidebar picks up the new config
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>Shows which program the WSL login shell would actually run for the command.</summary>
    private async Task FindClaudeAsync()
    {
        finding = true;
        foundMessage = null;
        try
        {
            var cmd = string.IsNullOrWhiteSpace(claudeCmd) ? "claude" : claudeCmd;
            foundPath = await Legion.FindWslProgramAsync(distro, cmd);
            // WSL appends the Windows PATH, so without a Linux install `claude` resolves to the Windows one under /mnt/
            foundIsWindows = foundPath?.StartsWith("/mnt/") == true;
            foundMessage = foundPath is null
                ? "WSL에서 찾지 못했습니다. WSL 안에 Claude Code를 설치하세요: curl -fsSL https://claude.ai/install.sh | bash"
                : foundIsWindows
                    ? $"{foundPath} → Windows용 claude입니다. 이대로면 PowerShell 환경에서 실행됩니다. WSL 안에 Claude Code를 설치한 뒤 그 경로를 지정하세요."
                    : $"실행 파일: {foundPath}";
        }
        finally
        {
            finding = false;
        }
    }
}
